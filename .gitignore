# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Env & secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem

# MCP server config (may reference local commands / secrets)
mcp.json
!mcp.json.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime / agent session data
.scratch/
.agent/
sessions/
*.sqlite
*.sqlite-*

# Agent workspace — where the agent's file tools write (AGENT_WORKSPACE)
workspace/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
