# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Which backend the CLI uses: "openai" (default), "anthropic", or "azure"
AGENT_PROVIDER=openai

# Permission mode: "default" (low-risk tools like read_file/write_file run freely;
# medium/high-risk like create_skill/MCP tools ask), "auto" (allow everything —
# trusted/sandboxed only), or "readonly" (only low-risk, NON-mutating tools run —
# so reads work but write_file is blocked).
AGENT_PERMISSION_MODE=default

# Workspace: the directory the agent's file tools (read/list/write) are confined
# to. Default: ./workspace (created + git-ignored). Point it at a folder to work
# on it, e.g. AGENT_WORKSPACE=. to work on the current directory.
# AGENT_WORKSPACE=./workspace

# Optional: compact the context once the estimate exceeds this many tokens.
# Leave unset to use the built-in default (dormant unless a run gets long).
# AGENT_MAX_CONTEXT_TOKENS=96000

# Optional: where reusable skills live (SKILL.md files). Default .agent/skills
# AGENT_SKILLS_DIR=.agent/skills

# Optional: Brave Search API key. Set it to enable the web_search tool — without
# it, web_search is simply not offered to the model. Get one at
# https://api-dashboard.search.brave.com/ (a free tier exists).
# BRAVE_API_KEY=...

# Optional: extra env-var names the `shell` tool passes through to commands.
# By default the child gets only a minimal allowlist (PATH, HOME, LANG, TERM,
# TMPDIR, SHELL, USER) so commands can't read your API keys. If a command needs
# another var (a proxy, NODE_ENV, …), add its NAME here (comma/space-separated).
# AGENT_SHELL_ENV_PASSTHROUGH=HTTP_PROXY,HTTPS_PROXY,NODE_ENV

# OpenAI backend
OPENAI_API_KEY=sk-...
# Optional: override the default model
OPENAI_MODEL=gpt-4o-mini
# Optional: override the API base (e.g. an Azure/proxy/local OpenAI-compatible endpoint)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic backend
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the default model
ANTHROPIC_MODEL=claude-sonnet-5
# Optional: override the API base
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Azure OpenAI backend (set AGENT_PROVIDER=azure to use it)
AZURE_OPENAI_API_KEY=...
# Base resource host — a full endpoint URL is fine, it's reduced to the origin
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
# Your Azure deployment name (used as the model)
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# Optional: API version (default 2025-04-01-preview)
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
